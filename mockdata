// 60-cell chain. status: "done" (both proofs in), "partial" (one proof in),
// "missed" (day passed, nothing submitted), "today", "upcoming"
export const CHAIN = Array.from({ length: 60 }, (_, i) => {
  const day = i + 1;
  if (day <= 6) return { day, status: "done" };
  if (day === 7) return { day, status: "missed" }; // real-world edge case: a missed day
  if (day >= 8 && day <= 11) return { day, status: "done" };
  if (day === 12) return { day, status: "today" };
  return { day, status: "upcoming" };
});
 
